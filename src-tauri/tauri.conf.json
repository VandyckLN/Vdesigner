{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vdesigner",
  "version": "2.0.0",
  "identifier": "br.com.vdesigner.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vdesigner",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Vandyck (VandyckLN)",
    "copyright": "Copyright (c) 2026 Vandyck (VandyckLN)",
    "license": "MIT",
    "homepage": "https://github.com/VandyckLN/Vdesigner",
    "shortDescription": "Converte, redimensiona e melhora imagens, com prévia ao vivo.",
    "longDescription": "Ferramenta de imagem para desenvolvedores e designers. Lê JPG, PNG, WebP, GIF, BMP, TIFF e SVG; grava WebP, AVIF, PNG, JPG, TIFF e ICO. Redimensiona sem distorção com Lanczos3 e ajusta nitidez, ruído e tom — tudo em uma janela, com prévia ao vivo e estimativa de tamanho antes de exportar.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}
